@article{zhao2016person,
  abbr={T-PAMI},
  title={Person Re-Identification by Saliency Learning},
  author={Zhao, Rui and Ouyang, Wanli and Wang, Xiaogang},
  journal={IEEE Transactions on Pattern Analysis and Machine Intelligence},
  volume={39},
  number={2},
  pages={356--370},
  year={2016},
  publisher={IEEE},
  bibtex_show={true},
  selected={true},
  abstract={Human eyes can recognize person identities based on small salient regions, i.e. person saliency is distinctive and reliable in pedestrian matching across disjoint camera views. However, such valuable information is often hidden when computing similarities of pedestrian images with existing approaches. Inspired by our user study result of human perception on person saliency, we propose a novel perspective for person re-identification based on learning person saliency and matching saliency distribution. The proposed saliency learning and matching framework consists of four steps: (1) adjacency constrained patch matching to build dense correspondence between image pairs; (2) two alternative methods (K-Nearest Neighbors and One-class SVM) to estimate a saliency score for each image patch without identity labels; (3) saliency matching based on patch matching; (4) saliency matching tightly integrated with patch matching in a unified structural RankSVM learning framework. The effectiveness of our approach is validated on four public datasets.}
}

@article{zhao2013counting,
  abbr={T-ITS},
  title={Counting Vehicles from Semantic Regions},
  author={Zhao, Rui and Wang, Xiaogang},
  journal={IEEE Transactions on Intelligent Transportation Systems},
  volume={14},
  number={2},
  pages={1016--1022},
  year={2013},
  publisher={IEEE},
  bibtex_show={true},
  html={http://ieeexplore.ieee.org/xpls/abs_all.jsp?arnumber=6478825},
  abstract={Automatically counting vehicles in complex traffic scenes from videos is challenging. Detection and tracking algorithms may fail due to occlusions, scene clutters, and large variations of viewpoints and vehicle types. We propose a new approach of counting vehicles through exploiting contextual regularities from scene structures by breaking the problem into simpler sub-problems that count vehicles on each path separately.}
}

